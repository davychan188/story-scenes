# xAI Grok — without this key the app runs in free demo mode
XAI_API_KEY=

# Optional alias
# GROK_API_KEY=

# Text model (default: grok-3-mini)
XAI_MODEL=grok-3-mini

# Image model (default: grok-imagine-image-2.0)
XAI_IMAGE_MODEL=grok-imagine-image-2.0

# Optional API base
# XAI_BASE_URL=https://api.x.ai/v1
